parse_and_methods = (
  run = (
    parse_and_methods methods do: [ :meth |
        meth holder print.
        meth signature println.
    ].
    Integer methods do: [ :meth |
        meth holder print.
        meth signature println.
    ].
  )
  ---
  func = (
    1 println.
  )
  func2 = (
    2 println.
  )
)
